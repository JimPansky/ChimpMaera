{
  "id": "chimpmaera-capability",
  "name": "PANSPHAIRA OPENCLAW-M1.4 Capability Gateway",
  "description": "Exposes one schema-validated synthetic CRM action through the isolated OpenClaw fixture.",
  "version": "1.0.0",
  "activation": { "onStartup": true },
  "contracts": { "tools": ["chimpmaera_capability_request"] },
  "configSchema": {
    "type": "object",
