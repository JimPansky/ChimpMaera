  },
  "scope": {
    "database": "WideWorldImporters",
    "container": null,
    "schemas": [
      "Application",
      "DataLoadSimulation",
      "db_accessadmin",
      "db_backupoperator",
      "db_datareader",
      "db_datawriter",
      "db_ddladmin",
      "db_denydatareader",
      "db_denydatawriter",
      "db_owner",
      "db_securityadmin",
      "dbo",
      "guest",
      "Integration",
      "PowerBI",
      "Purchasing",
      "Reports",
      "Sales",
      "Sequences",
      "Warehouse",
      "Website"
    ]
  },
  "policy": {
    "access": "READ_ONLY",
    "allowRowSamples": false,
    "maxQueryTimeoutMs": 30000
