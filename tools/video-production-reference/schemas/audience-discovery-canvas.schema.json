{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.org/schemas/audience-discovery-canvas-v1.json",
  "title": "ChimpMaera Audience Discovery Canvas",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "context", "decisionToInfluence", "primaryAudiences", "secondaryAudiences", "excludedAudiences", "assumptions", "evidence", "unknowns", "review"],
  "properties": {
    "schemaVersion": {"const": "cm.audience-discovery-canvas/v1"},
    "primaryAudiences": {"type": "array", "minItems": 1},
    "secondaryAudiences": {"type": "array", "minItems": 1},
    "excludedAudiences": {"type": "array", "minItems": 1},
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "classification", "evidenceRefs", "confidence", "owner", "reviewDate", "disconfirmingEvidence"],
        "properties": {
          "classification": {"enum": ["OBSERVED_FACT", "SOURCED_FACT", "HYPOTHESIS", "EDITORIAL_DECISION"]},
          "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]}
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["confidence", "antiStereotypeCheck", "privacyReview", "lockedRevisionSha256"],
      "properties": {
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "antiStereotypeCheck": {"const": "PASS"},
        "privacyReview": {"const": "PASS"},
        "lockedRevisionSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
