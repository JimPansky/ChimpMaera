{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.org/schemas/video-storyboard-v1.json",
  "title": "ChimpMaera governed video storyboard",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion", "visualContractVersion", "immutableRevisionSha256", "durationPolicy",
    "audienceLock", "storyArchitecture", "claims", "evidence", "scenes", "tail",
    "criticalTerms", "contactSheet", "reviews", "automatedPreflight", "readyForAssembly",
    "publicationPermission", "maturity"
  ],
  "properties": {
    "schemaVersion": {"const": "cm.video-storyboard/v1"},
    "visualContractVersion": {"const": "cm.visual-language-contract/2026-08-03-v1"},
    "immutableRevisionSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "durationPolicy": {"const": "CONTENT_DRIVEN"},
    "storyArchitecture": {
      "type": "object",
      "required": ["audience", "intendedDecision", "centralTension", "transformation", "proof", "implication", "oneNarrativeSpine"],
      "properties": {"oneNarrativeSpine": {"const": true}}
    },
    "scenes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id", "narrativeJob", "objective", "semanticAction", "visualType", "claimRefs",
          "evidenceRefs", "beforeState", "afterState", "narrationPurpose", "narration",
          "onScreenLabels", "compositionId", "visualDeltaScore", "keyframes",
          "transitionPurpose", "accessibilityNote"
        ],
        "properties": {
          "narrativeJob": {"enum": ["HOOK", "CONTEXT", "PROBLEM", "MECHANISM", "PROOF", "CONSEQUENCE", "TRANSITION", "CLOSE"]},
          "visualType": {"enum": ["AUTHORITY_FLOW", "STATE_TRANSITION", "COMPARISON", "DEPENDENCY_DAG", "CONTRIBUTION_PREFLIGHT", "SCOPE_NORMALIZATION", "PUBLIC_TRUTH_PATH", "UI_EXCERPT", "TERMINAL_EXCERPT", "CONTRACT_EXCERPT", "MEASURED_EVIDENCE"]},
          "onScreenLabels": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 48}},
          "visualDeltaScore": {"type": "number", "minimum": 0.2, "maximum": 1},
          "keyframes": {"type": "array", "minItems": 2}
        }
      }
    },
    "tail": {
      "type": "object",
      "required": ["staticSeconds", "silentSeconds", "purpose"],
      "properties": {
        "staticSeconds": {"type": "number", "minimum": 0, "maximum": 1.5},
        "silentSeconds": {"type": "number", "minimum": 0, "maximum": 1},
        "purpose": {"const": "NARRATIVE_CLOSE"}
      }
    },
    "readyForAssembly": {"type": "boolean"},
    "publicationPermission": {"enum": ["FORBIDDEN", "PERMITTED"]},
    "maturity": {"enum": ["L0_TECHNICAL_VALID", "L1_SCRIPT_COMPLETE", "L2_STORYBOARD_VALIDATED", "L3_VISUAL_DESIGN_APPROVED", "L4_ROUGH_CUT_APPROVED", "L5_PUBLICATION_READY", "L6_PUBLISHED_AND_READBACK_VERIFIED"]}
  }
}
