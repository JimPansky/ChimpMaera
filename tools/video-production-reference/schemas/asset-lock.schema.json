{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.local/schemas/asset-lock.schema.json",
  "title": "ChimpMaera Video Asset Lock",
  "type": "object",
  "required": ["id", "path", "sha256", "status", "mediaClass"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["accepted", "rejected", "unknown"]},
    "mediaClass": {"enum": ["png-shot", "wav-audio", "text", "csv", "svg", "model"]},
    "brandMediaBoundary": {"type": "string"},
    "optional": {"type": "boolean"},
    "replaceable": {"type": "boolean"},
    "omissionAllowed": {"type": "boolean"}
  }
}
