{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.local/schemas/scene.schema.json",
  "title": "ChimpMaera Video Scene",
  "type": "object",
  "required": ["sceneId", "startSeconds", "endSeconds", "shotPath", "sha256", "status", "narrativeJob", "objective", "semanticAction", "visualType", "beforeState", "afterState", "narrationPurpose", "onScreenLabels", "evidenceRefs", "nonClaimBoundary"],
  "additionalProperties": false,
  "properties": {
    "sceneId": {"type": "string", "pattern": "^S[0-9]{2}$"},
    "startSeconds": {"type": "number", "minimum": 0},
    "endSeconds": {"type": "number", "exclusiveMinimum": 0},
    "shotPath": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["accepted", "rejected", "unknown"]},
    "narrativeJob": {"enum": ["HOOK", "CONTEXT", "PROBLEM", "MECHANISM", "PROOF", "CONSEQUENCE", "TRANSITION", "CLOSE"]},
    "objective": {"type": "string", "minLength": 1},
    "semanticAction": {"type": "string", "minLength": 1},
    "visualType": {"type": "string", "minLength": 1},
    "beforeState": {},
    "afterState": {},
    "narrationPurpose": {"type": "string", "minLength": 1},
    "onScreenLabels": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 48}},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "nonClaimBoundary": {"type": "string", "minLength": 1},
    "visualPrinciple": {"type": "string"},
    "role": {"enum": ["content", "outro"]},
    "visualDescription": {"type": "string", "minLength": 1},
    "claimRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "nonClaimRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "safeArea": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "textBoxes": {"type": "array", "items": {"type": "object"}}
  }
}
