{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.org/schemas/public-copy-policy-v1.json",
  "title": "Reusable public-copy policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "language", "canonicalName", "narrationNumberStyle", "visibleNumberStyle", "immutableNumberExceptions", "forbiddenTerms", "forbiddenLanguageTokens", "scope"],
  "properties": {
    "schemaVersion": {"const": "cm.public-copy-policy/v1"},
    "policyId": {"type": "string", "minLength": 1},
    "language": {"const": "en"},
    "canonicalName": {"type": "string", "minLength": 1},
    "narrationNumberStyle": {"const": "english-words"},
    "visibleNumberStyle": {"const": "digits-with-english-units-and-dot-decimals"},
    "immutableNumberExceptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "forbiddenTerms": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "forbiddenLanguageTokens": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
