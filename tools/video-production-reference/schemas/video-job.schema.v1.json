{
  "$defs": {
    "selection": {
      "additionalProperties": false,
      "properties": {
        "backend": { "const": "cpu-ffmpeg-free" },
        "expectedVersion": { "pattern": "^(?:\\^|>=|<=|>|<|=)?[0-9]+\\.[0-9]+\\.[0-9]+$", "type": "string" }
      },
      "required": ["backend", "expectedVersion"],
      "type": "object"
    },
    "shot": {
      "additionalProperties": false,
      "properties": {
        "endFrame": { "minimum": 1, "type": "integer" },
        "id": { "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "type": "string" },
        "path": { "pattern": "^[A-Za-z0-9._-]+$", "type": "string" },
        "sceneId": { "pattern": "^S[0-9]{2}$", "type": "string" },
        "sha256": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
        "startFrame": { "minimum": 0, "type": "integer" },
        "status": { "const": "accepted" }
      },
      "required": ["endFrame", "id", "path", "sceneId", "sha256", "startFrame", "status"],
      "type": "object"
    }
  },
  "$id": "cm.video/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "cm.video/v1" },
    "kind": { "const": "VideoJob" },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "immutableOutputVersion": { "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$", "type": "string" },
        "name": { "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "type": "string" }
      },
      "required": ["immutableOutputVersion", "name"],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "additionalProperties": false,
          "properties": {
            "audio": {
              "additionalProperties": false,
              "properties": {
                "channels": { "const": 1 },
                "id": { "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "type": "string" },
                "path": { "pattern": "^[A-Za-z0-9._-]+$", "type": "string" },
                "sampleRate": { "const": 48000 },
                "sha256": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
                "status": { "const": "accepted" }
              },
              "required": ["channels", "id", "path", "sampleRate", "sha256", "status"],
              "type": "object"
            },
            "shots": { "items": { "$ref": "#/$defs/shot" }, "maxItems": 64, "minItems": 1, "type": "array" }
          },
          "required": ["audio", "shots"],
          "type": "object"
        },
        "audio": { "$ref": "#/$defs/selection" },
        "mode": { "enum": ["full-render", "validate-only"] },
        "qa": { "$ref": "#/$defs/selection" },
        "render": {
          "additionalProperties": false,
          "properties": {
            "backend": { "const": "cpu-ffmpeg-free" },
            "expectedVersion": { "pattern": "^(?:\\^|>=|<=|>|<|=)?[0-9]+\\.[0-9]+\\.[0-9]+$", "type": "string" },
            "overwrite": { "const": false },
            "publicActions": { "const": "forbidden" }
          },
          "required": ["backend", "expectedVersion", "overwrite", "publicActions"],
          "type": "object"
        },
        "roots": {
          "additionalProperties": false,
          "properties": { "assets": { "const": "assets/synthetic" } },
          "required": ["assets"],
          "type": "object"
        },
        "video": {
          "additionalProperties": false,
          "properties": {
            "declaredTargetPixelFormat": { "const": "yuv420p" },
            "durationFrames": { "minimum": 1, "type": "integer" },
            "durationSeconds": { "exclusiveMinimum": 0, "type": "number" },
            "fps": { "const": 30 },
            "height": { "const": 720 },
            "width": { "const": 1280 }
          },
          "required": ["declaredTargetPixelFormat", "durationFrames", "durationSeconds", "fps", "height", "width"],
          "type": "object"
        }
      },
      "required": ["assets", "audio", "mode", "qa", "render", "roots", "video"],
      "type": "object"
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "title": "Closed synthetic video package job",
  "type": "object"
}
