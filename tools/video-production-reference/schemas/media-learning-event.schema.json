{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://chimpmaera.org/schemas/media-learning-event-v1.json", "title": "Privacy-safe media learning event v1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "eventType", "occurredAt", "artifactRevisionSha256", "sourceClass", "scope", "outcome", "residualUncertainty", "aggregateCount", "routeReceipt"],
  "properties": {
    "schemaVersion": {"const": "cm.media-learning-event/v1"}, "eventId": {"type": "string", "minLength": 1}, "eventType": {"enum": ["AUDIENCE_HYPOTHESIS_RECORDED", "AUDIENCE_EVIDENCE_BOUND", "AUDIENCE_LOCKED", "SCRIPT_REVISED", "STORYBOARD_REVISED", "REVISION_REJECTED", "COMPREHENSION_PROBE_RECORDED", "PUBLIC_REACTION_CLASSIFIED", "FEEDBACK_ROUTED", "LEARNING_PROMOTED", "LEARNING_INVALIDATED", "OUTCOME_RECORDED"]}, "occurredAt": {"type": "string", "format": "date-time"}, "artifactRevisionSha256": {"$ref": "#/$defs/digest"}, "sourceClass": {"enum": ["SYNTHETIC_PROBE", "AGGREGATE_PUBLIC_SIGNAL", "CONSENTED_MINIMIZED_RESEARCH", "HUMAN_REVIEW"]}, "scope": {"type": "object", "additionalProperties": false, "required": ["audience", "contentFamily"], "properties": {"audience": {"type": "string"}, "contentFamily": {"type": "string"}}}, "outcome": {"type": "string", "minLength": 1}, "residualUncertainty": {"type": "string"}, "aggregateCount": {"type": "integer", "minimum": 1},
    "routeReceipt": {"type": "object", "additionalProperties": false, "required": ["changed", "notChanged", "why", "evidenceRefs", "owner", "reviewDate"], "properties": {"changed": {"type": "array", "items": {"type": "string"}}, "notChanged": {"type": "array", "items": {"type": "string"}}, "why": {"type": "string", "minLength": 1}, "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "owner": {"type": "string", "minLength": 1}, "reviewDate": {"type": "string", "format": "date"}}}
  }, "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
