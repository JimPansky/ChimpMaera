{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.org/schemas/video-methodology-consumed-deltas-v1.json",
  "title": "Consumed public process deltas",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "methodologyVersion", "baselineMethodologyVersion", "consumedDeltas", "decisionRecord"],
  "properties": {
    "schemaVersion": {"const": "cm.video-methodology-consumed-deltas/v1"},
    "methodologyVersion": {"type": "string", "minLength": 1},
    "baselineMethodologyVersion": {"type": "string", "minLength": 1},
    "consumedDeltas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deltaId", "publicDeltaPath", "publicDeltaSha256", "sourceEvidenceSha256", "sourceClassification"],
        "properties": {
          "deltaId": {"type": "string", "minLength": 1},
          "publicDeltaPath": {"type": "string", "pattern": "^[^/].*$"},
          "publicDeltaSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "sourceEvidenceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "sourceClassification": {"type": "string", "minLength": 1}
        }
      }
    },
    "decisionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption", "risk", "fallback", "reviewMarker", "rollbackMarker"],
      "properties": {
        "assumption": {"type": "string", "minLength": 1},
        "risk": {"type": "string", "minLength": 1},
        "fallback": {"type": "string", "minLength": 1},
        "reviewMarker": {"type": "string", "minLength": 1},
        "rollbackMarker": {"type": "string", "minLength": 1}
      }
    }
  }
}
