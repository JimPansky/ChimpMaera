{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.org/schemas/video-methodology-evidence-v1.json",
  "title": "Video methodology evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "methodologyVersion", "purpose", "jobRevisionSha256", "artifacts", "automatedGates", "reviews", "outro", "publicationBoundary"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^[^/].*$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "revisionSha256", "evidenceRef"],
      "properties": {
        "status": {"const": "PASS"},
        "reviewer": {"type": "string", "minLength": 1},
        "revisionSha256": {"$ref": "#/$defs/sha256"},
        "evidenceRef": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schemaVersion": {"const": "cm.video-methodology-evidence/v1"},
    "methodologyVersion": {"type": "string", "minLength": 1},
    "purpose": {"enum": ["smoke-fixture", "publication-candidate"]},
    "jobRevisionSha256": {"$ref": "#/$defs/sha256"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "automatedGates": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "status", "executionMode", "evidenceRef"],
        "properties": {
          "family": {"enum": ["full-decode", "stream-parity", "loudness", "subtitles", "safe-area", "asr", "ocr"]},
          "status": {"const": "PASS"},
          "executionMode": {"enum": ["executed", "fixture"]},
          "evidenceRef": {"type": "string", "minLength": 1}
        }
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["englishCopy", "semanticCorrelation"],
      "properties": {
        "englishCopy": {"$ref": "#/$defs/review"},
        "semanticCorrelation": {"$ref": "#/$defs/review"}
      }
    },
    "outro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "durationSeconds", "probeEvidenceRefs"],
      "properties": {
        "status": {"const": "PASS"},
        "durationSeconds": {"const": 10},
        "probeEvidenceRefs": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "minLength": 1}}
      }
    },
    "publicationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productionClaim", "note"],
      "properties": {
        "productionClaim": {"const": false},
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
