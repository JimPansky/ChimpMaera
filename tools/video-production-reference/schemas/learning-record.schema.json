{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://chimpmaera.org/schemas/learning-record-v1.json", "title": "Governed Learning Record v1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "stage", "assertionType", "provenance", "sourceDigests", "confidence", "scope", "applicabilityBoundary", "evidence", "dependencies", "derivedFrom", "versions", "reviewerGate", "reviewDate", "expiryOrReviewDate", "supersession", "rollback", "invalidation", "crossAudienceReuse", "declaredAdaptation", "integrity"],
  "properties": {
    "schemaVersion": {"const": "cm.learning-record/v1"}, "id": {"type": "string", "minLength": 1}, "stage": {"enum": ["L0_RAW_OBSERVATION", "L1_NORMALIZED_FINDING", "L2_VALIDATED_PATTERN", "L3_TEMPLATE_CANDIDATE", "L4_GOVERNED_TEMPLATE", "L5_CROSS_CONTEXT_REUSED", "L6_OUTCOME_VALIDATED"]}, "assertionType": {"enum": ["observed", "sourced", "hypothesis", "editorial-decision"]},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source", "observation", "normalization", "decision", "outputRevision", "testReviewEvidence", "outcome"], "properties": {"source": {"type": "string", "minLength": 1}, "observation": {"type": "string", "minLength": 1}, "normalization": {"type": "string", "minLength": 1}, "decision": {"type": "string", "minLength": 1}, "outputRevision": {"type": "string", "minLength": 1}, "testReviewEvidence": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "minLength": 1}}},
    "sourceDigests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "scope": {"type": "object", "additionalProperties": false, "required": ["audiences", "contentFamilies", "contentApplicability"], "properties": {"audiences": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "contentFamilies": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "contentApplicability": {"type": "string", "minLength": 1}}}, "applicabilityBoundary": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "polarity", "sourceDigest", "finding"], "properties": {"id": {"type": "string", "minLength": 1}, "polarity": {"enum": ["POSITIVE", "NEGATIVE", "REJECTED", "UNRESOLVED"]}, "sourceDigest": {"$ref": "#/$defs/digest"}, "finding": {"type": "string", "minLength": 1}}}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "derivedFrom": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "strongJustification": {"type": "string"}, "promotionGate": {"type": "object", "additionalProperties": false, "required": ["status", "objectiveEvidenceRefs"], "properties": {"status": {"const": "PASS"}, "objectiveEvidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "versions": {"type": "object", "additionalProperties": false, "required": ["tool", "template"], "properties": {"tool": {"type": "string", "minLength": 1}, "template": {"type": "string", "minLength": 1}}}, "reviewerGate": {"type": "object", "additionalProperties": false, "required": ["status", "reviewer"], "properties": {"status": {"enum": ["PENDING", "APPROVED", "REJECTED"]}, "reviewer": {"type": ["string", "null"]}}}, "reviewDate": {"type": "string", "format": "date"}, "expiryOrReviewDate": {"type": "string", "format": "date"},
    "supersession": {"type": "object", "additionalProperties": false, "required": ["supersedes", "supersededBy"], "properties": {"supersedes": {"type": ["string", "null"]}, "supersededBy": {"type": ["string", "null"]}}}, "rollback": {"type": "object", "additionalProperties": false, "required": ["target", "trigger"], "properties": {"target": {"type": "string", "minLength": 1}, "trigger": {"type": "string", "minLength": 1}}}, "invalidation": {"type": "object", "additionalProperties": false, "required": ["watch", "onChange"], "properties": {"watch": {"type": "array", "minItems": 4, "items": {"type": "string"}}, "onChange": {"const": "DOWNGRADE_OR_INVALIDATE_FAIL_CLOSED"}}},
    "crossAudienceReuse": {"type": "boolean"}, "declaredAdaptation": {"type": ["string", "null"]}, "integrity": {"type": "object", "additionalProperties": false, "required": ["sequence", "previousRecordSha256", "recordSha256"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "previousRecordSha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "recordSha256": {"$ref": "#/$defs/digest"}}}
  }, "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
