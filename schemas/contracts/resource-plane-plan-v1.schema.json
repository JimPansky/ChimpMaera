{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.org/schemas/contracts/resource-plane-plan-v1.schema.json",
  "title": "ChimpMaera declarative resource-plane plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "claim",
    "tenant",
    "actor",
    "selectedProfile",
    "authorityProfile",
    "authorityFree",
    "runtimeActivation",
    "sourceBindings",
    "planes",
    "effectiveRightsDiff",
    "inputDigest",
    "planDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "chimpmaera.resource-plane/declarative-plan/v1"
    },
    "claim": {
      "const": "DECLARATIVE_RESOURCE_PLANE_PLAN_ONLY_NO_EXECUTION"
    },
    "tenant": { "$ref": "#/$defs/identifier" },
    "actor": { "$ref": "#/$defs/identifier" },
    "selectedProfile": { "$ref": "#/$defs/profile" },
    "authorityProfile": {
      "enum": ["SAFE_GUIDED", "CUSTOM", "RAMPAGE_FULL_CONTROL_LAB"]
    },
    "authorityFree": { "const": true },
    "runtimeActivation": { "const": false },
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safeGuidedAuthorityResultDigest",
        "selectedAuthorityResultDigest"
      ],
      "properties": {
        "safeGuidedAuthorityResultDigest": { "$ref": "#/$defs/digest" },
        "selectedAuthorityResultDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "planes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/plane" }
    },
    "effectiveRightsDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineProfile",
        "selectedProfile",
        "added",
        "removed",
        "routeChanged",
        "entries"
      ],
      "properties": {
        "baselineProfile": { "const": "SAFE_GUIDED" },
        "selectedProfile": { "$ref": "#/$defs/profile" },
        "added": { "$ref": "#/$defs/rightReferences" },
        "removed": { "$ref": "#/$defs/rightReferences" },
        "routeChanged": { "$ref": "#/$defs/rightReferences" },
        "entries": {
          "type": "array",
          "minItems": 7,
          "items": { "$ref": "#/$defs/diffEntry" }
        }
      }
    },
    "inputDigest": { "$ref": "#/$defs/digest" },
    "planDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "enum": ["SAFE_GUIDED", "CUSTOM", "FULL_CONTROL"]
    },
    "planeId": {
      "enum": [
        "FILESYSTEM",
        "NETWORK",
        "PROCESS",
        "DOCKER",
        "SECRETS",
        "MODELS_TOOLS",
        "DEVICES"
      ]
    },
    "rightId": {
      "enum": [
        "filesystem.metadata.read",
        "filesystem.content.read",
        "filesystem.owned.write",
        "filesystem.delete",
        "network.resolve",
        "network.https.read",
        "network.https.write",
        "network.listen",
        "process.inspect",
        "process.spawn",
        "process.signal",
        "docker.inspect",
        "docker.image.pull",
        "docker.container.run",
        "docker.container.remove",
        "secrets.metadata.read",
        "secrets.value.read",
        "secrets.value.write",
        "models-tools.catalog.read",
        "models-tools.model.invoke",
        "models-tools.tool.invoke",
        "models-tools.tool.install",
        "devices.inspect",
        "devices.sensor.read",
        "devices.actuate"
      ]
    },
    "rightReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rightId" }
    },
    "plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planeId", "templateId", "requestedRights", "decisions"],
      "properties": {
        "planeId": { "$ref": "#/$defs/planeId" },
        "templateId": {
          "enum": [
            "chimpmaera.resource-plane/filesystem-closed/v1",
            "chimpmaera.resource-plane/network-closed/v1",
            "chimpmaera.resource-plane/process-closed/v1",
            "chimpmaera.resource-plane/docker-closed/v1",
            "chimpmaera.resource-plane/secrets-closed/v1",
            "chimpmaera.resource-plane/models-tools-closed/v1",
            "chimpmaera.resource-plane/devices-closed/v1"
          ]
        },
        "requestedRights": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/rightId" }
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/decision" }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rightId",
        "effectClass",
        "inHostSystemCeiling",
        "inOwnerProfile",
        "inAssignments",
        "inCurrentConstraints",
        "effective",
        "route",
        "reasonFacts"
      ],
      "properties": {
        "rightId": { "$ref": "#/$defs/rightId" },
        "effectClass": {
          "enum": [
            "READ_ONLY",
            "REVERSIBLE_WRITE",
            "IRREVERSIBLE_EFFECT",
            "INSTALL_ACTIVATE",
            "PUBLICATION"
          ]
        },
        "inHostSystemCeiling": { "type": "boolean" },
        "inOwnerProfile": { "type": "boolean" },
        "inAssignments": { "type": "boolean" },
        "inCurrentConstraints": { "type": "boolean" },
        "effective": { "type": "boolean" },
        "route": { "$ref": "#/$defs/route" },
        "reasonFacts": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "type": "string" }
        }
      }
    },
    "route": {
      "enum": ["AUTO_EXECUTE", "OWNER_APPROVAL", "DENY"]
    },
    "diffEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planeId",
        "rightId",
        "effectClass",
        "safeGuidedEffective",
        "safeGuidedRoute",
        "selectedEffective",
        "selectedRoute",
        "change"
      ],
      "properties": {
        "planeId": { "$ref": "#/$defs/planeId" },
        "rightId": { "$ref": "#/$defs/rightId" },
        "effectClass": {
          "enum": [
            "READ_ONLY",
            "REVERSIBLE_WRITE",
            "IRREVERSIBLE_EFFECT",
            "INSTALL_ACTIVATE",
            "PUBLICATION"
          ]
        },
        "safeGuidedEffective": { "type": "boolean" },
        "safeGuidedRoute": { "$ref": "#/$defs/route" },
        "selectedEffective": { "type": "boolean" },
        "selectedRoute": { "$ref": "#/$defs/route" },
        "change": {
          "enum": ["ADDED", "REMOVED", "ROUTE_CHANGED", "UNCHANGED"]
        }
      }
    }
  }
}
