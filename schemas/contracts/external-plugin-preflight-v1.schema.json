{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pansphaira.dev/schemas/contracts/external-plugin-preflight-v1.schema.json",
  "title": "External plugin execution-free static preflight request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "subject", "source", "licence", "compatibility", "files"],
  "properties": {
    "schemaVersion": {"const": "chimpmaera.extension-trust/external-plugin-preflight-request/v1"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectId", "subjectVersion", "format"],
      "properties": {
        "subjectId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$"},
        "subjectVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
        "format": {"enum": ["DSH_BUNDLE_PROFILE", "SKILL", "MCP_SERVER", "GENERIC_PACKAGE"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "mutable", "digest"],
      "properties": {
        "kind": {"const": "PINNED_CONTENT"},
        "locator": {"type": "string", "pattern": "^content\\+sha256:[a-f0-9]{64}$"},
        "mutable": {"const": false},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "evidenceRef"],
      "properties": {
        "spdx": {"type": "string", "pattern": "^[A-Za-z0-9.+-]{2,40}$"},
        "evidenceRef": {"type": "string", "pattern": "^artifact:sha256:[a-f0-9]{64}$"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "tag", "commit", "artifactDigest", "distTag"],
      "properties": {
        "kind": {"enum": ["NONE", "DEEPSEEK_HARNESS"]},
        "version": {"type": ["string", "null"]},
        "tag": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]},
        "artifactDigest": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}]},
        "distTag": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "NONE"}}},
          "then": {"properties": {"version": {"const": null}, "tag": {"const": null}, "commit": {"const": null}, "artifactDigest": {"const": null}, "distTag": {"const": null}}}
        },
        {
          "if": {"properties": {"kind": {"const": "DEEPSEEK_HARNESS"}}},
          "then": {"properties": {"version": {"type": "string"}, "tag": {"type": "string"}, "commit": {"type": "string"}, "artifactDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "distTag": {"type": "string"}}}
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "mediaType", "content", "digest"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["FILE", "SYMLINK"]},
          "mediaType": {"enum": ["application/json", "text/markdown", "text/plain", "text/yaml"]},
          "content": {"type": "string", "maxLength": 1000000},
          "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
