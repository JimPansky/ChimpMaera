{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.dev/schemas/contracts/skill-bundle-manifest-v1.schema.json",
  "title": "ChimpMaera canonical Skill Bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "bundleId", "version", "format", "entrypoint", "displayName",
    "license", "publisher", "source", "files", "dependencies", "capabilityContracts",
    "compatibility", "authority", "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.skill-bundle/manifest/v1" },
    "bundleId": { "$ref": "#/$defs/bundleId" },
    "version": { "$ref": "#/$defs/semver" },
    "format": { "const": "OPENCLAW_SKILL" },
    "entrypoint": { "const": "SKILL.md" },
    "displayName": { "type": "string", "minLength": 3, "maxLength": 80 },
    "license": { "enum": ["Apache-2.0", "MIT", "BSD-3-Clause", "CC0-1.0"] },
    "publisher": { "$ref": "#/$defs/publisherId" },
    "source": { "$ref": "#/$defs/source" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/manifestFile" }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "capabilityContracts": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/capability" }
    },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "authority": { "$ref": "#/$defs/authority" },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "LOCAL_DETERMINISTIC_CONTRACT_ONLY",
          "NO_LIVE_REGISTRY_OR_SIGNATURE_PROOF",
          "NO_INSTALLATION_OR_ACTIVATION_AUTHORITY",
          "DISCOVERY_OR_PRESENCE_IS_NOT_AUTHORITY",
          "OPENCLAW_V1_ONLY_COMPATIBILITY"
        ]
      }
    }
  },
  "$defs": {
    "bundleId": { "type": "string", "pattern": "^skillbundle:[a-z0-9][a-z0-9._-]{2,63}$" },
    "publisherId": { "type": "string", "pattern": "^publisher:[a-z0-9][a-z0-9._-]{2,63}$" },
    "id": { "type": "string", "pattern": "^[a-z]+:[a-z0-9][a-z0-9._-]{2,63}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?($|/))[A-Za-z0-9._/-]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "mutable"],
      "properties": {
        "kind": { "const": "LOCAL_CONTENT" },
        "locator": { "type": "string", "pattern": "^local\\+sha256:[a-f0-9]{64}$" },
        "mutable": { "const": false }
      }
    },
    "manifestFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "mediaType"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "role": { "enum": ["ENTRYPOINT", "DOC", "CONFIG", "ASSET", "TEST_FIXTURE"] },
        "mediaType": { "enum": ["text/markdown", "application/json", "text/plain"] }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "registry"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "digest": { "$ref": "#/$defs/digest" },
        "registry": { "const": "LOCAL_LOCK" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "version", "digest", "activationState"],
      "properties": {
        "capabilityId": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "digest": { "$ref": "#/$defs/digest" },
        "activationState": { "const": "INACTIVE" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrixId", "supported", "lkg"],
      "properties": {
        "matrixId": { "const": "chimpmaera.skill-bundle/compatibility-matrix/v1" },
        "supported": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/compatibilityCell" }
        },
        "lkg": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifestSchemaVersion", "lockSchemaVersion", "runtime"],
          "properties": {
            "manifestSchemaVersion": { "const": "chimpmaera.skill-bundle/manifest/v1" },
            "lockSchemaVersion": { "const": "chimpmaera.skill-bundle/lock/v1" },
            "runtime": { "const": "OPENCLAW" }
          }
        }
      }
    },
    "compatibilityCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer", "runtime", "manifestMajor", "manifestMinor", "lockMajor",
        "lockMinor", "contract", "status"
      ],
      "properties": {
        "consumer": { "enum": ["GENERATION", "ANALYSIS", "INSTALLATION", "ROLLBACK"] },
        "runtime": { "const": "OPENCLAW" },
        "manifestMajor": { "const": 1 },
        "manifestMinor": { "const": 0 },
        "lockMajor": { "const": 1 },
        "lockMinor": { "const": 0 },
        "contract": { "const": "chimpmaera.skill-bundle/compatibility/v1" },
        "status": { "const": "SUPPORTED" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installation", "activation", "grantedCapabilities"],
      "properties": {
        "installation": { "const": "NO_AUTHORITY" },
        "activation": { "const": "NO_AUTHORITY" },
        "grantedCapabilities": { "type": "array", "maxItems": 0 }
      }
    }
  }
}
