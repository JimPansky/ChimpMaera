{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.dev/schemas/contracts/bi-execution-spine-v1.schema.json",
  "title": "ChimpMaera CM-BI-EXEC governed BI execution spine bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "spineId", "contractVersion", "evidenceClass", "questions", "claimBoundary", "bundleDigest"],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.cm-bi-exec/governed-bi-execution-spine/v1" },
    "spineId": { "const": "cm-bi-exec-001-synthetic-contract-v1" },
    "contractVersion": { "const": "1.0.0" },
    "evidenceClass": { "const": "PUBLIC_SYNTHETIC" },
    "questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/question" }
    },
    "claimBoundary": { "const": "DECLARATIVE_BI_EXECUTION_SPINE_CONTRACT_ONLY_NO_RUNTIME_NO_SQL_ENGINE_NO_DASHBOARD_AUTHORITY_NO_PRODUCTION_DATA" },
    "bundleDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "integer", "minimum": 0 },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "intent", "sources", "semanticModel", "queryPlan", "executionReceipt", "verificationReport", "claim", "visualization", "questionDigest"],
      "properties": {
        "questionId": { "enum": ["crm-risk-exposure", "erp-margin-drift", "operation-quality-exception-rate"] },
        "intent": { "$ref": "#/$defs/intent" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/source" }
        },
        "semanticModel": { "$ref": "#/$defs/semanticModel" },
        "queryPlan": { "$ref": "#/$defs/queryPlan" },
        "executionReceipt": { "$ref": "#/$defs/executionReceipt" },
        "verificationReport": { "$ref": "#/$defs/verificationReport" },
        "claim": { "$ref": "#/$defs/claim" },
        "visualization": { "$ref": "#/$defs/visualization" },
        "questionDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "purpose", "naturalLanguage", "tenantBoundary"],
      "properties": {
        "actor": { "const": "CM_AGENT_SYNTHETIC" },
        "purpose": { "const": "READ_ONLY_BUSINESS_ANSWER" },
        "naturalLanguage": { "type": "string", "minLength": 1, "maxLength": 240 },
        "tenantBoundary": { "const": "PUBLIC_SYNTHETIC_ONLY" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "sourceDigest", "operationQualityDigest", "freshnessMs", "missingnessReasons"],
      "properties": {
        "system": { "enum": ["CRM_FIXTURE", "ERP_FIXTURE", "CM_OBS_FIXTURE"] },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "operationQualityDigest": { "$ref": "#/$defs/digest" },
        "freshnessMs": { "$ref": "#/$defs/timestamp" },
        "missingnessReasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["NONE", "EVIDENCE_NOT_PRODUCED", "SOURCE_REDACTED", "LATE_OBSERVED_EVENT", "SEQUENCE_GAP"] }
        }
      }
    },
    "semanticModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "version", "entities", "metric", "unit", "grain", "formulaDigest"],
      "properties": {
        "modelId": { "const": "cm-bi-semantic-synthetic-v1" },
        "version": { "const": "1.0.0" },
        "entities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["account", "invoice", "order", "operation_event"] }
        },
        "metric": { "enum": ["risk_exposure_eur", "margin_drift_pct", "quality_exception_rate"] },
        "unit": { "enum": ["EUR", "PERCENT"] },
        "grain": { "enum": ["account_month", "product_month", "operation_day"] },
        "formulaDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "queryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "kind", "allowedFields", "capabilitiesDenied", "planDigest"],
      "properties": {
        "planId": { "type": "string", "pattern": "^plan:[a-z0-9][a-z0-9-]{7,63}$" },
        "kind": { "const": "DECLARATIVE_AGGREGATE_PLAN" },
        "allowedFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["account_id", "customer_segment", "invoice_amount_eur", "invoice_status", "product_family", "order_margin_pct", "operation_quality_state", "operation_event_day"]
          }
        },
        "capabilitiesDenied": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "enum": ["ARBITRARY_SQL", "PYTHON", "SHELL", "NETWORK", "CREDENTIALS", "LIVE_CONNECTOR", "DASHBOARD_AUTHORITY"] }
        },
        "planDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "executionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "status", "executedAtMs", "rowCount", "resultDigest", "receiptDigest"],
      "properties": {
        "receiptId": { "type": "string", "pattern": "^receipt:[a-z0-9][a-z0-9-]{7,63}$" },
        "status": { "const": "SIMULATED_VERIFIED" },
        "executedAtMs": { "$ref": "#/$defs/timestamp" },
        "rowCount": { "type": "integer", "minimum": 0 },
        "resultDigest": { "$ref": "#/$defs/digest" },
        "receiptDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "verificationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "sourceLineageComplete", "formulaVerified", "freshness", "privacyVerified", "qualityStates", "missingnessReasons", "denialReasons"],
      "properties": {
        "outcome": { "const": "VERIFIED" },
        "sourceLineageComplete": { "const": true },
        "formulaVerified": { "const": true },
        "freshness": { "const": "FRESH" },
        "privacyVerified": { "const": true },
        "qualityStates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["PASS", "WARN"] }
        },
        "missingnessReasons": { "type": "array", "maxItems": 0 },
        "denialReasons": { "type": "array", "maxItems": 0 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "statement", "confidence", "nonAuthority", "claimDigest"],
      "properties": {
        "outcome": { "const": "ANSWERED" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 240 },
        "confidence": { "const": "BOUNDED_SYNTHETIC" },
        "nonAuthority": { "const": "NOT_A_DASHBOARD_NOT_PRODUCTION_NOT_SYSTEM_OF_RECORD" },
        "claimDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "visualization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fields", "unsupportedReason", "visualizationDigest"],
      "properties": {
        "kind": { "enum": ["KPI", "BAR", "TABLE"] },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["account_id", "customer_segment", "invoice_amount_eur", "invoice_status", "product_family", "order_margin_pct", "operation_quality_state", "operation_event_day"] }
        },
        "unsupportedReason": { "type": "null" },
        "visualizationDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
