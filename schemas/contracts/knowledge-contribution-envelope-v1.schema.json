{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.example/schemas/contracts/knowledge-contribution-envelope-v1.schema.json",
  "title": "Immutable Contribution Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","contributionId","rawInput","submissionDigest","licence","dataClassification","evidenceRefs","claims","contributionDigest"],
  "properties": {
    "schemaVersion": {"const":"chimpmaera.knowledge/contribution-envelope/v1"},
    "contributionId": {"type":"string","pattern":"^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$"},
    "rawInput": {"type":"string","minLength":1,"maxLength":32768},
    "submissionDigest": {"$ref":"#/$defs/digest"},
    "licence": {"enum":["CC0-1.0","CC-BY-4.0","APACHE-2.0","OWNER_AUTHORIZED","UNKNOWN"]},
    "dataClassification": {"enum":["PUBLIC_SYNTHETIC","OWNER_PRIVATE"]},
    "evidenceRefs": {"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160}},
    "claims": {"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/claim"}},
    "contributionDigest": {"$ref":"#/$defs/digest"}
  },
  "$defs": {
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "value":{"type":"object","additionalProperties":false,"required":["state","values","provenance"],"properties":{"state":{"enum":["VALUE","UNKNOWN","NOT_PROVIDED","NOT_APPLICABLE","EXPLICITLY_UNRESTRICTED"]},"values":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160}},"provenance":{"type":["string","null"],"enum":["DECLARED","EVIDENCE_DERIVED","INFERRED",null]}}},
    "applicability":{"type":"object","additionalProperties":false,"required":["domain","knowledge_type","role_responsibility","industry","organization_context","geography_jurisdiction_policy","process_stage","system_config","prerequisites_constraints_exceptions","task_audience_outcome","valid_time_freshness","epistemic_status","evidence_strength","sensitivity","license"],"properties":{"domain":{"$ref":"#/$defs/value"},"knowledge_type":{"$ref":"#/$defs/value"},"role_responsibility":{"$ref":"#/$defs/value"},"industry":{"$ref":"#/$defs/value"},"organization_context":{"$ref":"#/$defs/value"},"geography_jurisdiction_policy":{"$ref":"#/$defs/value"},"process_stage":{"$ref":"#/$defs/value"},"system_config":{"$ref":"#/$defs/value"},"prerequisites_constraints_exceptions":{"$ref":"#/$defs/value"},"task_audience_outcome":{"$ref":"#/$defs/value"},"valid_time_freshness":{"$ref":"#/$defs/value"},"epistemic_status":{"$ref":"#/$defs/value"},"evidence_strength":{"$ref":"#/$defs/value"},"sensitivity":{"$ref":"#/$defs/value"},"license":{"$ref":"#/$defs/value"}}},
    "claim":{"type":"object","additionalProperties":false,"required":["claimId","statement","selector","submissionDigest","applicability","evidenceRefs"],"properties":{"claimId":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$"},"statement":{"type":"string","minLength":1,"maxLength":2048},"selector":{"type":"object","additionalProperties":false,"required":["encoding","start","end","exact"],"properties":{"encoding":{"const":"UTF16_CODE_UNIT_OFFSET"},"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":1},"exact":{"type":"string","minLength":1,"maxLength":32768}}},"submissionDigest":{"$ref":"#/$defs/digest"},"applicability":{"$ref":"#/$defs/applicability"},"evidenceRefs":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160}}}}
  }
}
