{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.example/schemas/contracts/hmi-contribute-preflight-v1.schema.json",
  "title": "ChimpMaera HMI Contribute Preflight V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operation", "requestDigest", "inputDigest", "generationDigest",
    "preparationStatus", "preflightReasons", "subjectCapabilityIds", "citedSourceIds",
    "evidenceStatus", "authority", "effects"
  ],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.hmi/contribute-preflight/v1" },
    "operation": { "const": "contribute" },
    "requestDigest": { "$ref": "#/$defs/digest" },
    "inputDigest": { "$ref": "#/$defs/digest" },
    "generationDigest": { "$ref": "#/$defs/digest" },
    "preparationStatus": { "const": "PREPARATION_ONLY" },
    "preflightReasons": {
      "type": "array",
      "prefixItems": [
        { "const": "CONTRIBUTION_CAPABILITY_ABSENT" },
        { "const": "PUBLICATION_ROUTE_ABSENT" }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "subjectCapabilityIds": {
      "type": "array",
      "maxItems": 0
    },
    "citedSourceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contractId" }
    },
    "evidenceStatus": { "const": "LOCAL_SYNTHETIC" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedRights", "routeIds", "writeTargets"],
      "properties": {
        "requestedRights": { "type": "array", "maxItems": 0 },
        "routeIds": { "type": "array", "maxItems": 0 },
        "writeTargets": { "type": "array", "maxItems": 0 }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submissionPerformed", "publicationPerformed"],
      "properties": {
        "submissionPerformed": { "const": false },
        "publicationPerformed": { "const": false }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contractId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$" }
  }
}
