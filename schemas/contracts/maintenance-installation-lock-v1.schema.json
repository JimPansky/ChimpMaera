{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.org/schemas/maintenance-installation-lock-v1.schema.json",
  "title": "ChimpMaera immutable installation lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lockId", "releaseId", "versionAxes", "authorityProfileDigest", "lockDigest"],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.maintenance/installation-lock/v1" },
    "lockId": { "$ref": "#/$defs/id" },
    "releaseId": { "$ref": "#/$defs/version" },
    "versionAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "packs", "adapters", "policies", "schemas", "generations"],
      "properties": {
        "core": { "allOf": [{ "$ref": "#/$defs/axis" }, { "type": "array", "maxItems": 1 }] },
        "packs": { "$ref": "#/$defs/axis" },
        "adapters": { "$ref": "#/$defs/axis" },
        "policies": { "$ref": "#/$defs/axis" },
        "schemas": { "$ref": "#/$defs/axis" },
        "generations": { "$ref": "#/$defs/axis" }
      }
    },
    "authorityProfileDigest": { "$ref": "#/$defs/digest" },
    "lockDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "version", "digest"],
      "properties": {
        "componentId": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "axis": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } }
  }
}
