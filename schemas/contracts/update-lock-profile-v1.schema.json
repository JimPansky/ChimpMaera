{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.org/schemas/update-lock-profile-v1.schema.json",
  "title": "ChimpMaera exact update lock profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "components", "versionAxes", "authorityProfile", "lockDigest"],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.update/lock-profile/v1" },
    "releaseId": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentId", "version", "digest"],
        "properties": {
          "componentId": { "$ref": "#/$defs/id" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "versionAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlPlane", "dataModel", "evidence"],
      "properties": {
        "controlPlane": { "$ref": "#/$defs/axis" },
        "dataModel": { "$ref": "#/$defs/axis" },
        "evidence": { "$ref": "#/$defs/axis" }
      }
    },
    "authorityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "digest"],
      "properties": {
        "profileId": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "lockDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "axis": { "type": "string", "pattern": "^v[1-9][0-9]*$" }
  }
}
