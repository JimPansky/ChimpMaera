{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.org/schemas/maintenance-doctor-report-v1.schema.json",
  "title": "ChimpMaera public-safe read-only maintenance doctor report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "readOnly", "observedLockDigest", "compatibilityProfileDigest", "checks", "publicProjection", "generatedAtMs", "reportDigest"],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.maintenance/doctor-report/v1" },
    "reportId": { "$ref": "#/$defs/id" },
    "readOnly": { "const": true },
    "observedLockDigest": { "$ref": "#/$defs/digest" },
    "compatibilityProfileDigest": { "$ref": "#/$defs/digest" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "status", "reasonCode"],
        "properties": {
          "checkId": { "$ref": "#/$defs/id" },
          "status": { "enum": ["PASS", "FAIL", "NOT_OBSERVED"] },
          "reasonCode": { "enum": ["OBSERVATION_MATCHED", "OBSERVATION_MISMATCH", "OBSERVATION_UNAVAILABLE"] }
        }
      }
    },
    "publicProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "overallStatus", "reasonCodes"],
      "properties": {
        "releaseId": { "$ref": "#/$defs/version" },
        "overallStatus": { "enum": ["READY_FOR_REVIEW", "NOT_READY", "INCOMPLETE"] },
        "reasonCodes": { "type": "array", "minItems": 1, "items": { "enum": ["CONTRACTS_VALID", "CHECK_FAILED", "CHECK_UNAVAILABLE"] } }
      }
    },
    "generatedAtMs": { "type": "integer", "minimum": 0 },
    "reportDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
