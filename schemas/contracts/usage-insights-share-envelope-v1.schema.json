{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.dev/schemas/contracts/usage-insights-share-envelope-v1.schema.json",
  "title": "PANSPHAIRA opt-in synthetic usage-insights share envelope v1",
  "$comment": "The runtime additionally rejects accessors, symbols, non-enumerables, dangerous keys, aliases, cycles, sparse arrays, proxies and exotic prototypes before reading values. Endpoint policy state is intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "deletionId",
    "sharedAtMs",
    "events",
    "claimBoundary",
    "envelopeDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.usage-insights/share-envelope/v1" },
    "profile": { "enum": ["basic", "capability", "diagnostics"] },
    "deletionId": { "type": "string", "pattern": "^delete:v1:[a-f0-9]{64}$", "maxLength": 74 },
    "sharedAtMs": { "$ref": "#/$defs/timestamp" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "usage-insights-event-v1.schema.json" }
    },
    "claimBoundary": {
      "const": "DEFAULT_OFF_LOCAL_ONLY_UNLESS_EXPLICIT_LOOPBACK_OPT_IN_SYNTHETIC_REFERENCE_NO_PRODUCTION"
    },
    "envelopeDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$", "maxLength": 64 },
    "timestamp": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
