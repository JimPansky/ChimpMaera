{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.org/schemas/doctor-report-v1.schema.json",
  "title": "ChimpMaera public-safe read-only doctor report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "profile", "readOnly", "observedLockDigest", "checks", "generatedAtMs", "reportDigest"],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.doctor/report/v1" },
    "reportId": { "$ref": "#/$defs/id" },
    "profile": { "enum": ["QUICK", "STANDARD"] },
    "readOnly": { "const": true },
    "observedLockDigest": { "$ref": "#/$defs/digest" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "status", "reasonCode"],
        "properties": {
          "checkId": { "$ref": "#/$defs/id" },
          "status": { "enum": ["PASS", "FAIL", "NOT_OBSERVED"] },
          "reasonCode": { "enum": ["OBSERVATION_MATCHED", "OBSERVATION_MISMATCH", "OBSERVATION_UNAVAILABLE"] }
        }
      }
    },
    "generatedAtMs": { "type": "integer", "minimum": 0 },
    "reportDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
