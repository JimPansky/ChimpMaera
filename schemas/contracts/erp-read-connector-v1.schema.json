{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.org/schemas/erp-read-connector-v1.schema.json",
  "title": "ChimpMaera synthetic ERP read connector v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "connectorId", "defaultEnabled", "adapter", "evidenceClass", "tenantId", "identity", "operations", "fields", "policy", "contractDigest"],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.connector/erp-read/v1" }, "contractVersion": { "const": "1.0.0" }, "connectorId": { "const": "connector:synthetic-erp-bi-v1" },
    "defaultEnabled": { "const": false }, "adapter": { "const": "SUPPORTED_EXPORT_API_SHAPED" }, "evidenceClass": { "const": "LOCAL_SYNTHETIC" }, "tenantId": { "const": "tenant:synthetic-zoo" },
    "identity": { "const": { "principalId": "principal:bi-m1-reader", "scopes": ["erp.synthetic.bi.read"], "credentialSource": "EXPLICIT_REFERENCE_ONLY" } },
    "operations": { "const": ["LIST_CUSTOMERS", "LIST_ORDERS", "LIST_INVOICES", "READ_SOURCE_FACTS"] },
    "fields": { "const": { "customers": ["customerId", "customerStatus"], "orders": ["orderId", "customerId", "orderStatus", "orderDate", "totalMinor", "currency"], "invoices": ["invoiceId", "orderId", "customerId", "invoiceStatus", "issueDate", "dueDate", "totalMinor", "currency"] } },
    "policy": { "const": { "maxPageSize": 2, "maxAgeSeconds": 3600, "writesAllowed": false, "approvalsAllowed": false, "adminAllowed": false, "broadDatabaseAccessAllowed": false, "unknownFieldsAllowed": false } },
    "contractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
