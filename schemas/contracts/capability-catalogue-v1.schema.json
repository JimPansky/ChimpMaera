{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.example/schemas/contracts/capability-catalogue-v1.schema.json",
  "title": "ChimpMaera closed inactive capability catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogueId", "version", "digest", "activationDefault", "actions"],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.security/capability-catalogue/v1" },
    "catalogueId": { "const": "chimpmaera.local/synthetic-actions" },
    "version": { "const": "1.0.0" },
    "digest": { "const": "bb0060a254f450684bd17f6559d267d6f02d225c4c4d37479c3010c60d1b8427" },
    "activationDefault": { "const": "INACTIVE" },
    "actions": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/crmAction" },
        { "$ref": "#/$defs/erpAction" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  },
  "$defs": {
    "crmAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "actionId", "version", "digest", "resource", "requestSchema",
        "responseSchema", "resourceBounds", "evidenceContract", "limitations", "activationState"
      ],
      "properties": {
        "schemaVersion": { "const": "chimpmaera.security/capability-action/v1" },
        "actionId": { "const": "crm.contact.create" },
        "version": { "const": "1.0.0" },
        "digest": { "const": "8a032b1057fcd5c10497877cbb53ceadbd9f76fba899c630855ed5019045c24a" },
        "resource": { "const": "synthetic.crm.contact" },
        "requestSchema": {
          "const": {
            "type": "object",
            "additionalProperties": false,
            "required": ["email", "name"],
            "properties": {
              "email": { "type": "string", "minLength": 3, "maxLength": 120, "pattern": "^[^@\\s]+@example\\.test$" },
              "name": { "type": "string", "minLength": 1, "maxLength": 80 }
            }
          }
        },
        "responseSchema": {
          "const": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contactId"],
            "properties": { "contactId": { "type": "string", "pattern": "^synthetic-contact-[0-9]{3}$" } }
          }
        },
        "resourceBounds": { "$ref": "#/$defs/resourceBounds" },
        "evidenceContract": { "$ref": "#/$defs/evidenceContract" },
        "limitations": { "$ref": "#/$defs/limitations" },
        "activationState": { "const": "INACTIVE" }
      }
    },
    "erpAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "actionId", "version", "digest", "resource", "requestSchema",
        "responseSchema", "resourceBounds", "evidenceContract", "limitations", "activationState"
      ],
      "properties": {
        "schemaVersion": { "const": "chimpmaera.security/capability-action/v1" },
        "actionId": { "const": "erp.order.create" },
        "version": { "const": "1.0.0" },
        "digest": { "const": "a20f5c9b60cbb9af1d098ae31c5f3e46e37722c6a9548b9f25b331c0287b98ab" },
        "resource": { "const": "synthetic.erp.order" },
        "requestSchema": {
          "const": {
            "type": "object",
            "additionalProperties": false,
            "required": ["quantity", "sku"],
            "properties": {
              "quantity": { "type": "integer", "minimum": 1, "maximum": 100 },
              "sku": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^SYN-[A-Z0-9-]+$" }
            }
          }
        },
        "responseSchema": {
          "const": {
            "type": "object",
            "additionalProperties": false,
            "required": ["orderId"],
            "properties": { "orderId": { "type": "string", "pattern": "^synthetic-order-[0-9]{3}$" } }
          }
        },
        "resourceBounds": { "$ref": "#/$defs/resourceBounds" },
        "evidenceContract": { "$ref": "#/$defs/evidenceContract" },
        "limitations": { "$ref": "#/$defs/limitations" },
        "activationState": { "const": "INACTIVE" }
      }
    },
    "resourceBounds": {
      "const": {
        "maxRequestBytes": 512,
        "maxResponseBytes": 512,
        "maxExecutionMs": 1000,
        "maxInvocations": 1
      }
    },
    "evidenceContract": {
      "const": {
        "required": true,
        "allowedSinkTypes": ["SYNTHETIC_MEMORY"],
        "receiptSchemaVersion": "chimpmaera.security/capability-broker-receipt/v1",
        "correlationMode": "SHA256_SANITIZED"
      }
    },
    "limitations": {
      "const": [
        "LOCAL_SYNTHETIC_VALIDATION_ONLY",
        "NO_LIVE_PROVIDER_OR_CREDENTIAL_USE",
        "CATALOGUE_ADMISSION_DOES_NOT_ESTABLISH_SAFETY",
        "SYNCHRONOUS_PREPARE_BOUND_ONLY_NO_CANCELLATION",
        "IN_MEMORY_REPLAY_RESERVATION_ONLY"
      ]
    }
  }
}
