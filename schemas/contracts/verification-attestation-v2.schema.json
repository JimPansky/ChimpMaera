{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.dev/schemas/contracts/verification-attestation-v2.schema.json",
  "title": "ChimpMaera Verification Fabric prototype attestation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "nodeId", "nodeDigest", "graphDigest", "toolchainDigest", "environmentDigest", "createdAtMs", "testResults", "attestationDigest"],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.verification/attestation/v2" },
    "nodeId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "nodeDigest": { "$ref": "#/$defs/digest" },
    "graphDigest": { "$ref": "#/$defs/digest" },
    "toolchainDigest": { "$ref": "#/$defs/digest" },
    "environmentDigest": { "$ref": "#/$defs/digest" },
    "createdAtMs": { "type": "integer", "minimum": 0 },
    "expiresAtMs": { "type": "integer", "minimum": 0 },
    "testResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test", "outcome"],
        "properties": {
          "test": { "type": "string", "minLength": 1, "maxLength": 512 },
          "outcome": { "const": "PASS" }
        }
      }
    },
    "attestationDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
