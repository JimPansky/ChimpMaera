{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.dev/schemas/contracts/builder-quality-evidence-v1.schema.json",
  "title": "ChimpMaera Builder quality and evidence report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "claim", "issueId", "claimIds", "tenant", "systemId",
    "sourcePlanDigest", "qualityStatus", "focusedChecks", "negativeProbeCoverage",
    "reconciliation", "lifecycleRouteDecisions", "evidencePackage", "inputDigest",
    "reportDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.builder/quality-evidence/v1" },
    "claim": { "const": "SYNTHETIC_LOCAL_QUALITY_EVIDENCE_NO_INSTALLATION_ACTIVATION_MUTATION_OR_PUBLICATION" },
    "issueId": { "$ref": "#/$defs/issueId" },
    "claimIds": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "$ref": "#/$defs/claimId" }
    },
    "tenant": { "$ref": "#/$defs/identifier" },
    "systemId": { "$ref": "#/$defs/identifier" },
    "sourcePlanDigest": { "$ref": "#/$defs/digest" },
    "qualityStatus": { "enum": ["PASS_PREPARATION_REQUIRED", "PASS_READY_FOR_G6"] },
    "focusedChecks": {
      "type": "array", "minItems": 6, "maxItems": 32,
      "items": { "$ref": "#/$defs/focusedCheck" }
    },
    "negativeProbeCoverage": {
      "type": "array", "minItems": 8, "maxItems": 32,
      "items": { "$ref": "#/$defs/negativeProbe" }
    },
    "reconciliation": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": { "$ref": "#/$defs/reconciliation" }
    },
    "lifecycleRouteDecisions": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "$ref": "#/$defs/routeDecision" }
    },
    "evidencePackage": { "$ref": "#/$defs/evidencePackage" },
    "inputDigest": { "$ref": "#/$defs/digest" },
    "reportDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "issueId": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
    "claimId": { "type": "string", "pattern": "^[A-Z]+-[0-9]+-G[0-9]+$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableDigest": {
      "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "focusedCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["checkId", "status"],
      "properties": {
        "checkId": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "status": { "const": "PASS" }
      }
    },
    "negativeProbe": {
      "type": "object", "additionalProperties": false,
      "required": ["probeId", "expected", "status"],
      "properties": {
        "probeId": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "expected": { "const": "DENY_OR_EXPLICIT_NON_SUCCESS" },
        "status": { "const": "PASS" }
      }
    },
    "reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "status", "readbackDigest", "receiptDigest"],
      "properties": {
        "operationId": { "$ref": "#/$defs/identifier" },
        "status": {
          "enum": [
            "MATCHED_NO_CHANGE", "ROLLBACK_VERIFIED",
            "NOT_EXECUTED_UNRESOLVED_INTENT", "NOT_EXECUTED_OWNER_ROUTE_ONLY"
          ]
        },
        "readbackDigest": { "$ref": "#/$defs/nullableDigest" },
        "receiptDigest": { "$ref": "#/$defs/nullableDigest" }
      }
    },
    "routeDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "route", "decisionDigest"],
      "properties": {
        "action": { "enum": ["INSTALLATION", "ACTIVATION", "MUTATION", "PUBLICATION"] },
        "route": { "enum": ["AUTO_EXECUTE", "OWNER_APPROVAL", "DENY"] },
        "decisionDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidencePackage": {
      "type": "object", "additionalProperties": false,
      "required": [
        "evidenceId", "issueId", "claimIds", "deliveryStatus", "releaseStatus",
        "dataClassification", "sourcePlanDigest"
      ],
      "properties": {
        "evidenceId": { "type": "string", "pattern": "^evidence:[a-f0-9]{24}$" },
        "issueId": { "$ref": "#/$defs/issueId" },
        "claimIds": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": { "$ref": "#/$defs/claimId" }
        },
        "deliveryStatus": { "const": "locally_validated" },
        "releaseStatus": { "const": "NOT_RELEASED" },
        "dataClassification": { "const": "SYNTHETIC" },
        "sourcePlanDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
