{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimpmaera.example/schemas/contracts/hmi-explain-payload-v1.schema.json",
  "title": "ChimpMaera HMI Explain Payload V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operation", "requestDigest", "generationDigest", "subjectCapabilityIds",
    "citedSourceIds", "citationPolicy", "evidenceStatus", "authority"
  ],
  "properties": {
    "schemaVersion": { "const": "chimpmaera.hmi/explain-payload/v1" },
    "operation": { "const": "explain" },
    "requestDigest": { "$ref": "#/$defs/digest" },
    "generationDigest": { "$ref": "#/$defs/digest" },
    "subjectCapabilityIds": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contractId" }
    },
    "citedSourceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contractId" }
    },
    "citationPolicy": { "const": "CITATIONS_REQUIRED" },
    "evidenceStatus": { "const": "LOCAL_SYNTHETIC" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedRights", "routeIds", "writeTargets"],
      "properties": {
        "requestedRights": { "type": "array", "maxItems": 0 },
        "routeIds": { "type": "array", "maxItems": 0 },
        "writeTargets": { "type": "array", "maxItems": 0 }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contractId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9._-]{2,95}$" }
  }
}
