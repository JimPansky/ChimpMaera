{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.chimpmaera.dev/publication-broker-request-v1.schema.json","type":"object","additionalProperties":false,
  "required":["schemaVersion","operationId","project","issue","workOrder","lease","base","branch","mergeRequest","patch","requestedEffects","expiresAt","requestDigest"],
  "properties":{
    "schemaVersion":{"const":"chimpmaera.dev/publication-broker-request/v1"},"operationId":{"type":"string","pattern":"^publish:[a-z0-9][a-z0-9._-]{2,63}$"},
    "project":{"$ref":"#/$defs/project"},"issue":{"$ref":"#/$defs/issue"},"workOrder":{"type":"object","additionalProperties":false,"required":["id","digest"],"properties":{"id":{"type":"string","pattern":"^order:[a-z0-9][a-z0-9._-]{2,63}$"},"digest":{"$ref":"#/$defs/sha256"}}},
    "lease":{"type":"object","additionalProperties":false,"required":["id","expiresAt"],"properties":{"id":{"type":"string","pattern":"^lease:[a-z0-9][a-z0-9._-]{2,63}$"},"expiresAt":{"$ref":"#/$defs/dateTime"}}},
    "base":{"type":"object","additionalProperties":false,"required":["ref","commit"],"properties":{"ref":{"type":"string","pattern":"^[A-Za-z0-9._/-]+$"},"commit":{"$ref":"#/$defs/sha1"}}},
    "branch":{"type":"object","additionalProperties":false,"required":["name","expectedAbsent"],"properties":{"name":{"type":"string","pattern":"^cm/dev-worker/[1-9][0-9]*/[a-z0-9][a-z0-9-]{2,31}$"},"expectedAbsent":{"const":true}}},
    "mergeRequest":{"type":"object","additionalProperties":false,"required":["draft","title","description","targetBranch"],"properties":{"draft":{"const":true},"title":{"type":"string","minLength":1,"maxLength":120},"description":{"type":"string","minLength":1,"maxLength":2000},"targetBranch":{"type":"string","pattern":"^[A-Za-z0-9._/-]+$"}}},
    "patch":{"type":"object","additionalProperties":false,"required":["digest","changedPathsDigest","changes"],"properties":{"digest":{"$ref":"#/$defs/sha256"},"changedPathsDigest":{"$ref":"#/$defs/sha256"},"changes":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["path","beforeSha256","after"],"properties":{"path":{"$ref":"#/$defs/path"},"beforeSha256":{"$ref":"#/$defs/sha256"},"after":{"type":"string","maxLength":65536}}}}}},
    "requestedEffects":{"const":["CREATE_WORKER_BRANCH","PUSH_BOUNDED_PATCH","CREATE_DRAFT_MR"]},"expiresAt":{"$ref":"#/$defs/dateTime"},"requestDigest":{"$ref":"#/$defs/sha256"}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sha1":{"type":"string","pattern":"^[a-f0-9]{40}$"},"dateTime":{"type":"string","format":"date-time"},"path":{"type":"string","minLength":1,"maxLength":240,"pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"},"project":{"type":"object","additionalProperties":false,"required":["id","repository"],"properties":{"id":{"type":"string","minLength":1},"repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}}},"issue":{"type":"object","additionalProperties":false,"required":["iid","snapshotDigest"],"properties":{"iid":{"type":"integer","minimum":1},"snapshotDigest":{"$ref":"#/$defs/sha256"}}}}
}
