{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chimpmaera.dev/development-worker-profile-v1.schema.json",
  "title": "ChimpMaera Development Worker Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "enabled", "dataClass", "workloadIdentity", "capabilities", "modelAliases", "isolation", "harness"],
  "properties": {
    "schemaVersion": {"const": "chimpmaera.dev/development-worker-profile/v1"},
    "profileId": {"type": "string", "pattern": "^profile:[a-z0-9][a-z0-9._-]{2,63}$"},
    "enabled": {"const": false},
    "dataClass": {"const": "PUBLIC_OSS"},
    "workloadIdentity": {"type": "string", "pattern": "^workload:[a-z0-9][a-z0-9._-]{2,63}$"},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}, "uniqueItems": true},
    "modelAliases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modelAlias"}, "uniqueItems": true},
    "isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["network", "hostHome", "dockerSocket", "externalDirectories"],
      "properties": {
        "network": {"const": "DENY_EXCEPT_INTERNAL_FRONTDOOR"},
        "hostHome": {"const": false}, "dockerSocket": {"const": false}, "externalDirectories": {"const": false}
      }
    },
    "harness": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "version", "artifactDigest", "configDigest", "securityBoundary"],
      "properties": {
        "adapter": {"const": "opencode"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "artifactDigest": {"$ref": "#/$defs/sha256"}, "configDigest": {"$ref": "#/$defs/sha256"},
        "securityBoundary": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "modelAlias": {"enum": ["cm.dev.fast", "cm.dev.primary", "cm.dev.review", "cm.dev.escalate"]},
    "capability": {"enum": ["cm.dev.issue.read", "cm.dev.repository.snapshot.read", "cm.dev.model.invoke", "cm.dev.test.run", "cm.dev.ci.read", "cm.dev.ci.log.read-sanitized", "cm.dev.change.publish", "cm.dev.merge-request.create-draft", "cm.dev.merge-request.update-owned", "cm.dev.evidence.read"]}
  }
}
