{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.chimpmaera.dev/publication-broker-readback-v1.schema.json","type":"object","additionalProperties":false,"required":["schemaVersion","provider","projectId","branch","mergeRequest","commit","ci","readbackDigest"],
  "properties":{"schemaVersion":{"const":"chimpmaera.dev/publication-broker-readback/v1"},"provider":{"const":"GITLAB_COMPATIBLE_FAKE"},"projectId":{"type":"string","minLength":1},"branch":{"type":"object","additionalProperties":false,"required":["name","baseCommit","headCommit","protected"],"properties":{"name":{"type":"string"},"baseCommit":{"$ref":"#/$defs/sha1"},"headCommit":{"$ref":"#/$defs/sha1"},"protected":{"const":false}}},"mergeRequest":{"type":"object","additionalProperties":false,"required":["iid","state","draft","sourceBranch","targetBranch"],"properties":{"iid":{"type":"integer","minimum":1},"state":{"const":"OPEN"},"draft":{"const":true},"sourceBranch":{"type":"string"},"targetBranch":{"type":"string"}}},"commit":{"type":"object","additionalProperties":false,"required":["changedPaths","patchDigest"],"properties":{"changedPaths":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},"patchDigest":{"$ref":"#/$defs/sha256"}}},"ci":{"type":"object","additionalProperties":false,"required":["status","sanitized","logDigest"],"properties":{"status":{"enum":["NOT_RUN","PENDING","PASSED","FAILED"]},"sanitized":{"const":true},"logDigest":{"anyOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]}}},"readbackDigest":{"$ref":"#/$defs/sha256"}},"$defs":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sha1":{"type":"string","pattern":"^[a-f0-9]{40}$"}}
}
