{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chimpmaera.dev/daily-poc-manifest-v1.schema.json",
  "title": "ChimpMaera Daily POC Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "date",
    "sequence",
    "source",
    "targetVersion",
    "history",
    "highlights",
    "useCases",
    "controls",
    "evidence",
    "claims",
    "tests",
    "negativeProbes",
    "reproductionCommands",
    "knownLimitations",
    "externalGates",
    "video",
    "publication"
  ],
  "properties": {
    "schemaVersion": {"const": "chimpmaera.daily-poc/v1"},
    "date": {"type": "string", "format": "date"},
    "sequence": {"type": "integer", "minimum": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base", "head"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "base": {"$ref": "#/$defs/gitCommit"},
        "head": {"$ref": "#/$defs/gitCommit"}
      }
    },
    "targetVersion": {"$ref": "#/$defs/pocVersion"},
    "history": {
      "type": "array",
      "items": {"$ref": "#/$defs/snapshot"}
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "commitIds", "issueIds", "fileRefs", "caseIds"],
        "properties": {
          "id": {"$ref": "#/$defs/stableId"},
          "title": {"$ref": "#/$defs/nonEmpty"},
          "description": {"$ref": "#/$defs/nonEmpty"},
          "commitIds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gitCommit"}, "uniqueItems": true},
          "issueIds": {"type": "array", "items": {"type": "string", "pattern": "^(?:#[1-9][0-9]*|[A-Z][A-Z0-9-]+-[0-9]+)$"}, "uniqueItems": true},
          "fileRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repoPath"}, "uniqueItems": true},
          "caseIds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stableId"}, "uniqueItems": true}
        }
      }
    },
    "useCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "inputs", "steps", "expectedOutcomes", "demoUtility", "evidenceRefs"],
        "properties": {
          "id": {"$ref": "#/$defs/stableId"},
          "title": {"$ref": "#/$defs/nonEmpty"},
          "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}},
          "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}},
          "expectedOutcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}},
          "demoUtility": {"$ref": "#/$defs/nonEmpty"},
          "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "default", "allowedOverrides", "dependencies"],
        "properties": {
          "id": {"$ref": "#/$defs/stableId"},
          "description": {"$ref": "#/$defs/nonEmpty"},
          "default": {},
          "allowedOverrides": {"type": "array", "items": {}},
          "dependencies": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}, "uniqueItems": true}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "sha256", "maturity", "status", "observedOn", "validUntil", "sourceCommit"],
        "properties": {
          "id": {"$ref": "#/$defs/stableId"},
          "kind": {"enum": ["SOURCE", "TEST", "NEGATIVE_PROBE", "CI", "RELEASE_ATTESTATION", "PRODUCTION_RECORD"]},
          "path": {"$ref": "#/$defs/repoPath"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "maturity": {"$ref": "#/$defs/maturity"},
          "status": {"const": "PASS"},
          "observedOn": {"type": "string", "format": "date"},
          "validUntil": {"type": "string", "format": "date"},
          "sourceCommit": {"$ref": "#/$defs/gitCommit"}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "statement", "maturity", "evidenceRefs", "nonClaims"],
        "properties": {
          "id": {"type": "string", "pattern": "^CM-CLAIM-[A-Z0-9-]+$"},
          "category": {"enum": ["FEATURE", "SECURITY", "OPERATIONS"]},
          "statement": {"$ref": "#/$defs/nonEmpty"},
          "maturity": {"$ref": "#/$defs/maturity"},
          "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"},
          "nonClaims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "statement", "contradictsClaimIds"],
              "properties": {
                "id": {"$ref": "#/$defs/stableId"},
                "statement": {"$ref": "#/$defs/nonEmpty"},
                "contradictsClaimIds": {"type": "array", "items": {"type": "string", "pattern": "^CM-CLAIM-[A-Z0-9-]+$"}, "uniqueItems": true}
              }
            }
          }
        }
      }
    },
    "tests": {"$ref": "#/$defs/checks"},
    "negativeProbes": {"$ref": "#/$defs/checks"},
    "reproductionCommands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}},
    "knownLimitations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}},
    "externalGates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}},
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language", "description", "renderDefault", "rendererContract", "segments", "assets", "prerequisites"],
      "properties": {
        "title": {"$ref": "#/$defs/nonEmpty"},
        "language": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
        "description": {"$ref": "#/$defs/nonEmpty"},
        "renderDefault": {"const": false},
        "rendererContract": {"const": "cm.video/v1"},
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "order", "durationSeconds", "title", "purpose", "narration", "visuals", "claimRefs", "useCaseRefs"],
            "properties": {
              "id": {"$ref": "#/$defs/stableId"},
              "order": {"type": "integer", "minimum": 1},
              "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
              "title": {"$ref": "#/$defs/nonEmpty"},
              "purpose": {"$ref": "#/$defs/nonEmpty"},
              "narration": {"$ref": "#/$defs/nonEmpty"},
              "visuals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}},
              "claimRefs": {"type": "array", "items": {"type": "string", "pattern": "^CM-CLAIM-[A-Z0-9-]+$"}, "uniqueItems": true},
              "useCaseRefs": {"type": "array", "items": {"$ref": "#/$defs/stableId"}, "uniqueItems": true}
            }
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role", "status", "segmentRef", "path", "sha256"],
            "properties": {
              "id": {"$ref": "#/$defs/stableId"},
              "role": {"enum": ["SHOT", "AUDIO", "NARRATION_LOCK", "FACTS_LOCK", "REFERENCE"]},
              "status": {"enum": ["PLANNED", "ACCEPTED", "REJECTED"]},
              "segmentRef": {"anyOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]},
              "path": {"type": ["string", "null"]},
              "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
            }
          }
        },
        "prerequisites": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["githubPrerelease", "youtubeUpload", "readmeMutation", "approvals"],
      "properties": {
        "githubPrerelease": {"type": "boolean", "default": false},
        "youtubeUpload": {"type": "boolean", "default": false},
        "readmeMutation": {"type": "boolean", "default": false},
        "approvals": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}}
      }
    }
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "stableId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "gitCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repoPath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"},
    "pocVersion": {"type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)-poc\\.[0-9]{8}\\.[1-9][0-9]*$"},
    "maturity": {"enum": ["DESIGNED", "LOCALLY_VALIDATED", "CI_VALIDATED", "MERGED", "RELEASED", "PRODUCTION_VALIDATED"]},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stableId"}, "uniqueItems": true},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "sequence", "version", "sourceHead", "manifestSha256", "artifactManifestSha256", "snapshotDigest"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "sequence": {"type": "integer", "minimum": 1},
        "version": {"$ref": "#/$defs/pocVersion"},
        "sourceHead": {"$ref": "#/$defs/gitCommit"},
        "manifestSha256": {"$ref": "#/$defs/sha256"},
        "artifactManifestSha256": {"$ref": "#/$defs/sha256"},
        "snapshotDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "result", "evidenceRefs"],
        "properties": {
          "id": {"$ref": "#/$defs/stableId"},
          "command": {"$ref": "#/$defs/nonEmpty"},
          "result": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
          "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}
        }
      }
    }
  }
}
