{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chimpmaera.dev/work-receipt-v1.schema.json",
  "title": "ChimpMaera Development Work Receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "workOrderDigest", "outcome", "baseCommit", "candidateCommit", "changedPaths", "changedPathsDigest", "patchDigest", "tests", "review", "modelUsage", "capabilityUsage", "publication", "readback", "cleanup", "nonClaims", "receiptDigest"],
  "properties": {
    "schemaVersion": {"const": "chimpmaera.dev/work-receipt/v1"}, "workOrderDigest": {"$ref": "#/$defs/sha256"},
    "outcome": {"enum": ["SUCCEEDED", "DENIED", "FAILED"]}, "baseCommit": {"$ref": "#/$defs/sha1"}, "candidateCommit": {"type": "null"},
    "changedPaths": {"type": "array", "items": {"$ref": "#/$defs/repoPath"}, "uniqueItems": true}, "changedPathsDigest": {"$ref": "#/$defs/sha256"}, "patchDigest": {"$ref": "#/$defs/sha256"},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["command", "outcome", "outputDigest"], "properties": {"command": {"type": "string", "minLength": 1}, "outcome": {"enum": ["PASS", "FAIL"]}, "outputDigest": {"$ref": "#/$defs/sha256"}}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["outcome", "findings"], "properties": {"outcome": {"enum": ["PASS", "NOT_RUN"]}, "findings": {"type": "array", "items": {"type": "string"}}}},
    "modelUsage": {"type": "object", "additionalProperties": false, "required": ["alias", "providerPolicyDigest", "requests", "inputTokens", "outputTokens", "costMicros"], "properties": {"alias": {"$ref": "#/$defs/modelAlias"}, "providerPolicyDigest": {"$ref": "#/$defs/sha256"}, "requests": {"type": "integer", "minimum": 0}, "inputTokens": {"type": "integer", "minimum": 0}, "outputTokens": {"type": "integer", "minimum": 0}, "costMicros": {"type": "integer", "minimum": 0}}},
    "capabilityUsage": {"type": "array", "items": {"$ref": "#/$defs/capability"}, "uniqueItems": true},
    "publication": {"type": "object", "additionalProperties": false, "required": ["performed", "identifiers"], "properties": {"performed": {"const": false}, "identifiers": {"type": "array", "maxItems": 0}}},
    "readback": {"type": "object", "additionalProperties": false, "required": ["synthetic", "digest"], "properties": {"synthetic": {"const": true}, "digest": {"$ref": "#/$defs/sha256"}}},
    "cleanup": {"type": "object", "additionalProperties": false, "required": ["outcome", "writableStateRemaining"], "properties": {"outcome": {"const": "PASS"}, "writableStateRemaining": {"const": false}}},
    "nonClaims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "receiptDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "repoPath": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"},
    "modelAlias": {"enum": ["cm.dev.fast", "cm.dev.primary", "cm.dev.review", "cm.dev.escalate"]},
    "capability": {"enum": ["cm.dev.issue.read", "cm.dev.repository.snapshot.read", "cm.dev.model.invoke", "cm.dev.test.run", "cm.dev.ci.read", "cm.dev.ci.log.read-sanitized", "cm.dev.change.publish", "cm.dev.merge-request.create-draft", "cm.dev.merge-request.update-owned", "cm.dev.evidence.read"]}
  }
}
