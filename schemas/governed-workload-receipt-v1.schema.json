{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.chimpmaera.dev/governed-workload-receipt-v1.schema.json","type":"object","additionalProperties":false,
  "required":["schemaVersion","outcome","requestDigest","workload","admissionSequence","adapter","scope","usage","result","authority","nonClaims","receiptDigest"],
